# MySQL connection
DATABASE_URL=mysql+pymysql://root:your-password@localhost:3306/recruitment_ai?charset=utf8mb4

# dev | prod (prod bắt buộc JWT_SECRET khác giá trị mặc định)
APP_ENV=dev
JWT_SECRET=replace-with-a-random-secret
JWT_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Gemini API key
GEMINI_API_KEY=your-api-key
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_CONCURRENCY=4

MAX_COMPARE_JOBS=5
MAX_ACTIVE_APPLICATIONS=20
